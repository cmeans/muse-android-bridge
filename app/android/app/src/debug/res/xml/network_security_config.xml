<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP to the emulator's host address, where the
     local test ntfy server runs (10.0.2.2:8081). Release builds keep Android's
     default of HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
