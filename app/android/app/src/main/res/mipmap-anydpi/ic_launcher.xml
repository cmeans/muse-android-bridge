<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: the bridge glyph on the bridge blue, with a
     monochrome layer for Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/bridge_blue" />
    <foreground>
        <inset android:drawable="@drawable/ic_bridge_white" android:inset="30dp" />
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/ic_bridge_white" android:inset="30dp" />
    </monochrome>
</adaptive-icon>
