<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the bridge glyph in white on a solid circle, so it reads on any wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1E6FD9" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_bridge_white" android:left="26dp" android:top="26dp" android:right="26dp" android:bottom="26dp" />
</layer-list>
